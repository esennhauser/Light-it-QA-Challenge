  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "01 - Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains token and persists to environment\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.expect(jsonData.token).to.be.a('string').that.is.not.empty;",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Main Flow - Reschedule",
      "item": [
        {
          "name": "02 - Get User Appointments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Appointments list is an array and extracts targets\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.above(0, \"No appointments found for user\");",
                  "    ",
                  "    // Pick first available appointment",
                  "    var targetApp = jsonData[0];",
                  "    pm.collectionVariables.set(\"appointment_id\", targetApp.id);",
                  "    pm.collectionVariables.set(\"doctor_id\", targetApp.doctor_id);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ]
            }
          },
          "response": []
        },
        {
          "name": "03 - Check Doctor Availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Time slots array is present\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('time_slots');",
                  "    pm.expect(jsonData.time_slots).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{doctor_id}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors",
                "{{doctor_id}}",
                "availability"
              ]
            }
          },
          "response": []
        },
        {
          "name": "04 - Reschedule Appointment (Happy Path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Reschedule response structure and values are valid\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    ",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData).to.have.property('appointment');",
                  "    ",
                  "    // Convertir ambos a formato YYYY-MM-DD descartando la hora T00:00:00.000Z",
                  "    var receivedDate = String(jsonData.appointment.appointment_date).split('T')[0];",
                  "    var expectedDate = pm.collectionVariables.get(\"new_date\");",
                  "    ",
                  "    pm.expect(receivedDate).to.eql(expectedDate);",
                  "    pm.expect(jsonData.appointment.time_slot).to.eql(pm.collectionVariables.get(\"new_time_slot\"));",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointment_date\": \"{{new_date}}\",\n  \"time_slot\": \"{{new_time_slot}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{appointment_id}}/reschedule",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "{{appointment_id}}",
                "reschedule"
              ]
            }
          },
          "response": []
        },
        {
          "name": "05 - Verify Updated Appointment Detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Appointment details reflect updated schedule\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    ",
                  "    pm.expect(jsonData.id).to.eql(parseInt(pm.variables.get(\"appointment_id\")));",
                  "    ",
                  "    // Limpieza de formato de fecha ISO para la cita obtenida",
                  "    var receivedDate = String(jsonData.appointment_date).split('T')[0];",
                  "    var expectedDate = pm.collectionVariables.get(\"new_date\");",
                  "    ",
                  "",
                  "    pm.expect(receivedDate).to.eql(expectedDate);",
                  "    pm.expect(jsonData.time_slot).to.eql(pm.collectionVariables.get(\"new_time_slot\"));",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{appointment_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "{{appointment_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
